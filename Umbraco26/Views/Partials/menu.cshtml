@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Web.Website.Controllers
@using Umbraco26.Models

@inherits UmbracoViewPage<IPageViewModel>

@inject IMemberManager MemberManager

@{
	var current = Model.Content;
	var currentPath = current.Path.Split(',');

	// The start page is every page's ancestor, so it is only current on itself; other items also on the pages below them
	bool IsCurrent(IPublishedContent item) =>
		item.Id == current.Id || (item.Id != Model.StartPage?.Id && currentPath.Contains(item.Id.ToString()));
}

<nav class="navbar navbar-expand-lg bg-dark border-bottom border-body site-menu" data-bs-theme="dark" aria-label="@Umbraco.GetDictionaryValueOrDefault("Menu.Label", "Main menu")">
	<div class="container">
		<a class="navbar-brand fw-semibold" href="/">
			<i class="fas fa-film me-2 text-warning"></i>Movie Finder
		</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-menu-items"
				aria-controls="site-menu-items" aria-expanded="false" aria-label="@Umbraco.GetDictionaryValueOrDefault("Menu.Toggle", "Show or hide the menu")">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="site-menu-items">
			<ul class="navbar-nav me-auto">
				@foreach (var item in Model.MenuItems)
				{
					var isCurrent = IsCurrent(item);

					<li class="nav-item">
						<a class="nav-link@(isCurrent ? " active" : null)" href="@item.Url()" aria-current="@(isCurrent ? "page" : null)">@item.Name</a>
					</li>
				}
			</ul>
			@if (Model.FindPageUrl is string findPageUrl)
			{
				var isFind = current is Find;

				<ul class="navbar-nav">
					<li class="nav-item">
						<a class="nav-link@(isFind ? " active" : null)" href="@findPageUrl" aria-current="@(isFind ? "page" : null)">
							<i class="fas fa-magnifying-glass me-2" aria-hidden="true"></i>@Umbraco.GetDictionaryValueOrDefault("Find.NavLink", "Search")
						</a>
					</li>
				</ul>
			}
			@if (MemberManager.IsLoggedIn())
			{
				<ul class="navbar-nav">
					@if (Model.AccountPageUrl is string accountPageUrl)
					{
						var isAccount = current is Account;

						<li class="nav-item">
							<a class="nav-link@(isAccount ? " active" : null)" href="@accountPageUrl" aria-current="@(isAccount ? "page" : null)">
								<i class="fas fa-user me-2" aria-hidden="true"></i>@Umbraco.GetDictionaryValueOrDefault("Member.AccountLink", "My account")
							</a>
						</li>
					}
					<li class="nav-item">
						@using (Html.BeginUmbracoForm<UmbLoginStatusController>(nameof(UmbLoginStatusController.HandleLogout), new { RedirectUrl = Model.StartPage?.Url() ?? "/" }))
						{
							<button type="submit" class="nav-link">
								<i class="fas fa-right-from-bracket me-2" aria-hidden="true"></i>@Umbraco.GetDictionaryValueOrDefault("Member.Logout", "Log out")
							</button>
						}
					</li>
				</ul>
			}
			else if (Model.LoginPageUrl is string loginPageUrl)
			{
				var isLogin = current is Login;

				<ul class="navbar-nav">
					<li class="nav-item">
						<a class="nav-link@(isLogin ? " active" : null)" href="@loginPageUrl" aria-current="@(isLogin ? "page" : null)">
							<i class="fas fa-right-to-bracket me-2" aria-hidden="true"></i>@Umbraco.GetDictionaryValueOrDefault("Member.LoginLink", "Log in")
						</a>
					</li>
				</ul>
			}
		</div>
	</div>
</nav>
