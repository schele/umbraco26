@{
	Layout = "root.cshtml";

	var cultureName = System.Globalization.CultureInfo.CurrentCulture.Name;
}

@await Html.GetBlockListHtmlAsync(Model.Content.CarouselList)

<component type="typeof(OmdbSearchPage)" render-mode="Server" param-CultureName="@cultureName" param-MoviePageUrl="@Model.MoviePageUrl" />