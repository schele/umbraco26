@using Umbraco26.Models.ViewModels
@using Umbraco26.Blazor

@inherits UmbracoViewPage<StartPageViewModel>

@{
	Layout = "root.cshtml";

	var cultureName = System.Globalization.CultureInfo.CurrentCulture.Name;
}

@if (Model.Carousel != null)
{
	@await Html.PartialAsync("~/Views/Partials/carousel.cshtml", Model.Carousel)
}

<component type="typeof(OmdbSearchPage)" render-mode="Server" param-CultureName="@cultureName" />