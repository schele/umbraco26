<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Package source mapping. Required because central package management (CPM) is enabled
    in Umbraco26/Directory.Packages.props and more than one package source is configured
    (see the user-level NuGet.Config); without a mapping, restore emits NU1507.

    Sources themselves are still inherited from the user/machine config - this file only
    decides which source is allowed to serve which package IDs, so the credentials stored
    for esatto-packages keep working.

    Matching rule: the longest matching pattern wins and is the ONLY source consulted,
    so Esatto.* / Backoffice.* resolve from esatto-packages and everything else from nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="esatto-packages">
      <package pattern="Esatto.*" />
      <package pattern="Backoffice.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
